# Environment variables for GameArena
# Copy this to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/gamearena

# Paystack Payment Configuration
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
# Transfers must be enabled for the Paystack integration. Configure the public
# webhook URL in the Paystack dashboard so transfer.success, transfer.failed,
# and transfer.reversed reach /paystack/webhook.

# Email Configuration
# Resend is preferred. EMAIL_FROM must use a sender/domain verified in Resend.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@your-verified-domain.example

# Optional SMTP fallback if Resend is unavailable or rejects the request.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Other settings
MAX_PARTICIPANTS_DEFAULT=50
TOURNAMENT_TIMEOUT_HOURS=24
