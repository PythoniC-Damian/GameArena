# Environment variables for GameArena
# Copy this to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/gamearena

# Paystack Payment Configuration
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
# Transfers must be enabled for the Paystack integration. Configure the public
# webhook URL in the Paystack dashboard so transfer.success, transfer.failed,
# and transfer.reversed reach /paystack/webhook.

# Email Configuration
# Use HTTPS Resend for production. Verify gamearena01.com in Resend first.
# Set secrets in the host environment; never commit a real API key.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="GameArena <noreply@gamearena01.com>"

# Optional SMTP for local/supported hosts: set EMAIL_PROVIDER=smtp or auto.
# Render Free blocks SMTP ports; use Resend there to avoid slow failed attempts.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Other settings
MAX_PARTICIPANTS_DEFAULT=50
TOURNAMENT_TIMEOUT_HOURS=24

# Optional shared Redis pub/sub when scaling Socket.IO across instances.
# Keep unset for a single instance; keep credentials in host environment only.
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0

# Optional infrastructure. Leave jobs disabled until a worker is running.
BACKGROUND_JOBS_ENABLED=false
# JOB_REDIS_URL=rediss://... (trusted private Redis; web and worker share it)
# CACHE_REDIS_URL=rediss://... (public JSON snapshots only)
# SOCKET_RATE_LIMIT_REDIS_URL=rediss://... (atomic per-account event limits)
CACHE_NAMESPACE=gamearena
PUBLIC_BASE_URL=https://gamearena01.com
SLOW_REQUEST_MS=1000

# Keep null until queue pooling is verified under the deployed gevent worker.
DATABASE_POOL_MODE=null
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=300
# MIGRATION_DATABASE_URL=postgresql://... (optional direct/session Supabase URL)

# Configure Supabase Storage to move uploads out of the database fallback.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=... (server only)
SUPABASE_AVATAR_BUCKET=avatars
